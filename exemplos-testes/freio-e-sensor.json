      "expected_event_type": "test_result"
    },
    {
      "id": "H05",
      "current_utterance": "Repeat B1 tomorrow as new run B2, again with actuator A9 deenergized and subjected to a stationary 120 N load.",
      "expected_store_memory": true,
      "expected_event_type": "test_proposal"
    },
    {
      "id": "H06",
      "current_utterance": "The drawing number for the A9 actuator brake is BA-4.",
      "expected_store_memory": true,
      "expected_event_type": "observation"
