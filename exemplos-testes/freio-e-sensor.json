      "expected_event_type": "test_result"
    },
    {
      "id": "H11",
      "current_utterance": "The 60 C specified in the P1 thermal-test plan is the chamber setpoint, not the probe temperature.",
      "expected_store_memory": true,
      "expected_event_type": "requirement"
    },
    {
      "id": "H12",
      "current_utterance": "Based on the bracket-expansion measurement reported in P1, we decided to add a compliant bracket mount to the next probe prototype.",
