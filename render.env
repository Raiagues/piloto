# Importe em Render > serviço Norte > Environment > Add from .env.
# Este arquivo contém SOMENTE configuração pública; preserve as chaves existentes.
NORTE_PROVIDER=official
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EXTRACTION_MODEL=gemini-3.8-flash
GEMINI_EXTRACTION_THINKING_LEVEL=low
GEMINI_DISCOVERY_MODEL=gemini-3.5-flash-lite
GEMINI_DISCOVERY_THINKING_LEVEL=minimal
GEMINI_ORGANIZATION_MODEL=gemini-3.5-flash-lite
NORTE_EXTRACTION_CHUNKS_PER_RUN=24
NORTE_DEMO_ACCOUNT=0
# Standard até 31/12/2026; atualizar para 1.50 / 7.50 em 01/01/2027.
MINUTES_INPUT_USD_PER_MILLION=0.75
MINUTES_OUTPUT_USD_PER_MILLION=3.75
MINUTES_DAILY_CALL_LIMIT=50
AI_AGENTS_ENABLED=true
AI_EXTERNAL_REVIEW_ENABLED=true
AI_AGENT_PROVIDER=gemini
AI_AGENT_MODEL=gemini-3.5-flash-lite
AI_GEMINI_INPUT_USD_PER_MILLION=0.30
AI_GEMINI_OUTPUT_USD_PER_MILLION=2.50
AI_DAILY_BUDGET_USD=1.00
AI_DAILY_CALL_LIMIT=50
AI_AUTO_PUBLISH=true
AI_RETENTION_DAYS=90
JEV_INPUT_USD_PER_MILLION=0.042
JEV_OUTPUT_USD_PER_MILLION=0
