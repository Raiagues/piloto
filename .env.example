# Copie para .env para rodar localmente (./start). Nunca coloque chaves reais neste exemplo.
# No Render, estes valores são preenchidos na tela do serviço (Environment), não em arquivo.
NORTE_PROVIDER=official
TYPESAFE_API_KEY=
# Ata redigida no backend com Gemini (também aceita GEMINI_API_KEY).
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tarifa Standard até 31/12/2026; em 01/01/2027 atualizar para 1.50 / 7.50.
MINUTES_INPUT_USD_PER_MILLION=0.75
MINUTES_OUTPUT_USD_PER_MILLION=3.75
# Tentativas de organização por dia UTC, compartilhadas entre contas. 0 desativa.
MINUTES_DAILY_CALL_LIMIT=50

# Conta admin: criada/atualizada sempre que o servidor inicia. Senha com 8+ caracteres.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Opcional. Vazio = SQLite local em .runtime/norte.sqlite3. No Render vem do banco automaticamente.
DATABASE_URL=
# Opcional. Se preenchido, só cria conta quem souber este código de convite.
SIGNUP_CODE=
# Opcional. Domínios próprios (ex.: norte.com.br,www.norte.com.br). O endereço .onrender.com já é aceito.
ALLOWED_HOSTS=

# Agentes de melhoria: mesma GOOGLE_API_KEY, execução fora da resposta ao vivo.
# Tarifas em USD / 1 milhão de tokens, verificadas em 15/10/2026.
# Ao trocar o modelo, confira e atualize ambas as tarifas.
AI_AGENTS_ENABLED=true
# Envia somente frases candidatas; estado físico fica no replay local.
AI_EXTERNAL_REVIEW_ENABLED=true
AI_AGENT_PROVIDER=gemini
AI_AUTO_PUBLISH=true
AI_AGENT_MODEL=gemini-3.5-flash-lite
AI_GEMINI_INPUT_USD_PER_MILLION=0.30
AI_GEMINI_OUTPUT_USD_PER_MILLION=2.50
# Alternativa legada; não necessária na configuração recomendada.
# gpt-4.1-mini será desligado em 14/01/2027: validar migração antes de adotar.
# Para usar, escolha AI_AGENT_PROVIDER=openai e preencha a chave.
OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4.1-mini
AI_OPENAI_INPUT_USD_PER_MILLION=0.40
AI_OPENAI_OUTPUT_USD_PER_MILLION=1.60
AI_DAILY_BUDGET_USD=1.00
AI_DAILY_CALL_LIMIT=50
AI_RETENTION_DAYS=90
JEV_INPUT_USD_PER_MILLION=0.042
JEV_OUTPUT_USD_PER_MILLION=0
# Só preencha se seu contrato cobrar por chamada; não some às tarifas por token.
JEV_USD_PER_REQUEST=

# Norte integrado: reutiliza a mesma GOOGLE_API_KEY/GEMINI_API_KEY acima.
GEMINI_EXTRACTION_MODEL=gemini-3.8-flash
GEMINI_EXTRACTION_THINKING_LEVEL=low
GEMINI_DISCOVERY_MODEL=gemini-3.5-flash-lite
GEMINI_DISCOVERY_THINKING_LEVEL=minimal
GEMINI_ORGANIZATION_MODEL=gemini-3.5-flash-lite
# Cada rodada lê até 24 trechos; a interface permite continuar o restante.
NORTE_EXTRACTION_CHUNKS_PER_RUN=24
NORTE_DEMO_PROFILE=validation
# A ponte privada é gerada por ./start; não precisa de outra chave de API.
# Produção: código aleatório de 32 a 512 caracteres para criar o primeiro administrador.
# O Blueprint gera o valor; copie do Environment para o campo de configuração inicial.
# Nunca use prefixo VITE_, URL ou Git para transportar este segredo. Pode remover após configurar.
# NORTE_BOOTSTRAP_TOKEN=

# Administração: opcional, definir ANTES da primeira configuração de TOTP.
# Ausente: usa o segredo persistente NORTE_MEETING_BRIDGE_SECRET.
# Preserve a chave após inscrever autenticadores; não use prefixo VITE_.
# NORTE_ADMIN_ENCRYPTION_KEY=
# Geografia de métricas: apenas para proxy confiável que remove headers do cliente.
# NORTE_GEO_HEADER_SECRET=

# Chamada WebRTC: servidor TURN externo com credenciais HMAC temporárias.
# NORTE_TURN_URLS=turn:seu-turn:3478,turns:seu-turn:443?transport=tcp
# NORTE_TURN_SECRET=
# Vídeo HTTPS opcional para Como usar o chat.
# NORTE_CHAT_TUTORIAL_URL=https://seu-dominio/tutorials/feedback.mp4
