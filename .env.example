# Copie para .env para rodar localmente (./start). Nunca coloque chaves reais neste exemplo.
# No Render, estes valores são preenchidos na tela do serviço (Environment), não em arquivo.
NORTE_PROVIDER=official
TYPESAFE_API_KEY=
# Ata redigida no backend com Gemini (também aceita GEMINI_API_KEY).
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-pro-preview

# Conta admin: criada/atualizada sempre que o servidor inicia. Senha com 8+ caracteres.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Opcional. Vazio = SQLite local em .runtime/norte.sqlite3. No Render vem do banco automaticamente.
DATABASE_URL=
# Opcional. Se preenchido, só cria conta quem souber este código de convite.
SIGNUP_CODE=
# Opcional. Domínios próprios (ex.: norte.com.br,www.norte.com.br). O endereço .onrender.com já é aceito.
ALLOWED_HOSTS=
