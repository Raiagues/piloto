#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if ! command -v python3 >/dev/null 2>&1; then
  echo "Erro: Python 3 não foi encontrado. Instale o Python 3 e rode ./setup novamente."
  exit 1
fi

chmod +x "$PROJECT_DIR/start" "$PROJECT_DIR/stop" "$PROJECT_DIR/setup"
mkdir -p "$PROJECT_DIR/.runtime"

python3 "$PROJECT_DIR/scripts/prepare_local.py"

# Use the verified app copy when the system runtime is older than 24.20.
if [[ -x "$PROJECT_DIR/.runtime/tools/node-v24.20.0-linux-x64/bin/node" ]] && ! node -e 'const [a,b]=process.versions.node.split(".").map(Number);process.exit(a>24||(a===24&&b>=20)?0:1)' >/dev/null 2>&1; then
  export PATH="$PROJECT_DIR/.runtime/tools/node-v24.20.0-linux-x64/bin:$PATH"
fi
"$PROJECT_DIR/.venv/bin/python" "$PROJECT_DIR/config.py"

echo "Preparando e compilando a interface..."
cd "$PROJECT_DIR/norte"
if [[ ! -f node_modules/.package-lock.json ]] || [[ package-lock.json -nt node_modules/.package-lock.json ]]; then
  npm ci --no-audit --no-fund
fi
VITE_BASE_PATH=/ npm run build

echo "Configuração concluída."
echo "Na raiz do projeto, use ./start para abrir o site no navegador ou ./stop para encerrá-lo."
