GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Vazio/default mantém o padrão do provedor. Gemini 3: low, medium, high (minimal conforme modelo).
GEMINI_THINKING_LEVEL=
# Overrides por funcionalidade; default ignora o nível global, vazio herda.
GEMINI_DISCOVERY_THINKING_LEVEL=
GEMINI_EXTRACTION_THINKING_LEVEL=
GEMINI_ORGANIZATION_THINKING_LEVEL=
# Cada funcionalidade também aceita GEMINI_<FEATURE>_MODEL.
GEMINI_DISCOVERY_MAX_OUTPUT_TOKENS=8192
GEMINI_EXTRACTION_MAX_OUTPUT_TOKENS=16000
GEMINI_ORGANIZATION_MAX_OUTPUT_TOKENS=6000
# Obrigatória no Render: projetos e documentos usam PostgreSQL persistente.
DATABASE_URL=
# Primeiro administrador em produção: código aleatório privado, 32 a 512 caracteres.
# O Blueprint gera o valor; não usar VITE_. Pode remover após o primeiro cadastro.
NORTE_BOOTSTRAP_TOKEN=
NORTE_API_HOST=127.0.0.1
NORTE_API_PORT=8787
NORTE_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Botão "Explorar com conta de teste" na tela de login: cria um sandbox descartável
# (equipe e projetos fictícios, apagado em 24 h). Ligado fora de produção; em produção use 1.
NORTE_DEMO_ACCOUNT=

# Convites e verificação por email. SMTP existente; sem provedor obrigatório.
# URL pública completa do frontend, incluindo /norte/ quando necessário.
NORTE_PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
