{
  "name": "norte",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raiagues/piloto.git"
  },
  "homepage": "https://norte-r007.onrender.com/",
  "bugs": {
    "url": "https://github.com/Raiagues/piloto/issues"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort --open /norte/",
    "dev:api": "node server/index.mjs",
    "start": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run && node --test server/*.test.mjs",
    "test:api": "node --test server/*.test.mjs",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "security:audit": "npm audit --audit-level=high",
    "quality": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:visual:meetings": "node scripts/visual-meetings.mjs",
    "test:visual": "node scripts/visual-workspace.mjs",
    "test:visual:collaboration": "node scripts/visual-collaboration-refresh.mjs",
    "test:visual:documents": "node scripts/visual-document-workspace.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "argon2": "^0.45.2",
    "fastify": "^5.12.8",
    "fflate": "^0.8.3",
    "lucide-react": "^1.69.0",
    "nodemailer": "^10.3.1",
    "pdfjs-dist": "^6.5.438",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.9.1",
    "pg-mem": "^3.0.14",
    "playwright-core": "^1.62.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.12"
  }
}
